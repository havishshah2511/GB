# Copy to .env and edit. Every value below is optional — the defaults run.

# --- server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Used when building share links from background jobs (no request context).
PUBLIC_BASE_URL=

# --- storage --------------------------------------------------------------
DB_PATH=data/groupbuy.db

# --- admin ----------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=admin
# Signs the admin session cookie. Set a long random value in production.
ADMIN_SECRET=
ADMIN_SESSION_HOURS=12

# --- AI -------------------------------------------------------------------
# Leave empty to run the deterministic rules NLU (no network, no key).
# With a key set, Claude extracts slots and the rules engine backs it up.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=1024

# --- matching -------------------------------------------------------------
# Minimum overlap between two buyers' purchase windows before they can pool.
MATCH_MIN_WINDOW_OVERLAP_DAYS=1
# 0-100. Below this an intent starts a new group instead of joining one.
MATCH_SCORE_THRESHOLD=60

# --- intent lifecycle -----------------------------------------------------
INTENT_GRACE_DAYS=2
RECONFIRM_LEAD_DAYS=3

# --- notification rules (spec section 20) ---------------------------------
NOTIFY_PROGRESS_STEPS=50,80,90
NOTIFY_NEAR_TARGET_GAP=3
NOTIFY_MAX_PER_CUSTOMER_PER_DAY=2
NOTIFY_DEFAULT_CHANNEL=whatsapp

# --- background worker ----------------------------------------------------
ENABLE_BACKGROUND_WORKER=1
WORKER_INTERVAL_SECONDS=60

# --- misc -----------------------------------------------------------------
CURRENCY_SYMBOL=₹
# Loads ten demo intents on first boot so the dashboard isn't empty.
SEED_DEMO_DATA=1
